{
  "name": "Lignarc Commerce Dashboard",
  "short_name": "Lignarc",
  "description": "Wayfair CastleGate & Amazon sales, profit, ads and incidents for Lignarc",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "background_color": "#efebe3",
  "theme_color": "#efebe3",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Sales", "url": "./#sales", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Profit", "url": "./#profit", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Incidents & Returns", "url": "./#quality", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
